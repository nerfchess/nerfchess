# Cloudflare Workers static-assets header rules (the ASSETS binding serves
# these files directly, before the OpenNext worker runs, so a Next.js
# headers() rule alone does not reach them).
#
# Everything under /_next/static/ is content-hashed: the filename changes
# whenever the bytes do, so a year-long immutable cache is both safe and
# correct. Do NOT add HTML (or any non-hashed route) here: HTML must stay
# revalidatable so a deploy is picked up promptly.

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Non-hashed public art and audio that changes rarely (F113). Without a rule
# they were served with max-age=0, so the lobby revalidated every house avatar
# on every visit. One day fresh plus a week of stale-while-revalidate: a
# replaced file shows up within a day, and never blocks a page. Keep this list
# in step with PUBLIC_ASSET_DIRS in next.config.mjs.

/house-pfp/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/piece/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/sound/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/companions/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/brainrot/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/newjeans/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
