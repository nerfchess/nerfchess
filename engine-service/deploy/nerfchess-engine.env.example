# Copy to /etc/nerfchess-engine.env  (chmod 600, owned by root:root).
# This file holds the shared secret — never commit the real values.

# Shared bearer token. MUST match the Worker's HOUSE_ENGINE_TOKEN secret
# (wrangler secret put HOUSE_ENGINE_TOKEN). Generate: openssl rand -hex 32
HOUSE_ENGINE_TOKEN=replace-with-shared-bearer-secret

# MUST equal the Worker's REPLAY_VERSION constant (worker.ts). If they differ,
# the service returns 409 and the DO falls back to local compute. Bump this in
# lockstep whenever REPLAY_VERSION changes.
ENGINE_REPLAY_VERSION=3

# Local port the cloudflared tunnel forwards engine.nerfchess.com to.
PORT=8787
