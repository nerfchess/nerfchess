{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "name": "drawbackchess",
  "compatibility_date": "2026-05-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "nerfchess.com",
      "custom_domain": true
    },
    {
      "pattern": "www.nerfchess.com",
      "custom_domain": true
    }
  ],
  "vars": {
    // Promoted to admin on their next login (see docs/moderation.md).
    "ADMIN_USERNAMES": "ilovenewjeans,ruylopezsolos",
    // OAuth client id for "Continue with Google" (see docs/google-sign-in.md).
    // The matching secret is set with: wrangler secret put GOOGLE_CLIENT_SECRET
    // Leave empty to disable Google sign-in.
    "GOOGLE_CLIENT_ID": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nerfchess",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_SERVER",
        "class_name": "GameServer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameServer"
      ]
    }
  ],
  "observability": {
    "enabled": true
  }
}
