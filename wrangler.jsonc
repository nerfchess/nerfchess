{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "name": "drawbackchess",
  "compatibility_date": "2026-05-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "nerfchess.com",
      "custom_domain": true
    },
    {
      "pattern": "www.nerfchess.com",
      "custom_domain": true
    }
  ],
  "vars": {
    // Promoted to admin on their next login (see docs/moderation.md).
    "ADMIN_USERNAMES": "ilovenewjeans,ruylopezsolos",
    // OAuth client id for "Continue with Google" (see docs/google-sign-in.md).
    // The matching secret is set with: wrangler secret put GOOGLE_CLIENT_SECRET
    // Leave empty to disable Google sign-in.
    "GOOGLE_CLIENT_ID": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nerfchess",
      "migrations_dir": "migrations"
    }
  ],
  // OCI Postgres holding the finished-game archive (large, append-only), reached
  // over a Cloudflare Tunnel. DISABLED: the id below was never a real Hyperdrive
  // config on this account, and deploying with an unknown id makes every
  // Workers Build fail (the site was stuck on an old build because of it).
  // The code falls back to the D1 games table while this is off. To enable:
  //   1. wrangler hyperdrive create nerfchess-pg --connection-string="postgres://nerfchess_app:PASSWORD@HOST:5432/nerfchess?sslmode=require"
  //   2. Paste the REAL id it prints into the block below and uncomment it.
  //   3. Re-run scripts/backfill-games.mjs to top up the Postgres archive.
  // Local dev: set WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE instead.
  // "hyperdrive": [
  //   {
  //     "binding": "HYPERDRIVE",
  //     "id": "PASTE_REAL_HYPERDRIVE_ID_HERE"
  //   }
  // ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_SERVER",
        "class_name": "GameServer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameServer"
      ]
    }
  ],
  "observability": {
    "enabled": true
  }
}
