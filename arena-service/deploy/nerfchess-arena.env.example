# Copy to /etc/nerfchess-arena.env  (chmod 600, root:root).

# Bearer token for the local observability endpoints (/stats, /games, /finished,
# /pause, /resume). /healthz is open. Generate: openssl rand -hex 32
ARENA_TOKEN=replace-with-a-random-token

# MUST equal the Worker's REPLAY_VERSION so archived games (M2) replay cleanly.
ARENA_REPLAY_VERSION=3

# Max concurrent bot-vs-bot games (= houseVsHouseCap today). Raise after M4.
ARENA_MAX_GAMES=18

# Master switch; M2 drives pause/resume via the DO channel instead.
ARENA_ENABLED=true

# Local port (distinct from the engine service on 8787). Not tunnel-exposed in M1.
PORT=8788

# Set "true" to log every move/draft (noisy) — leave off in normal operation.
ARENA_VERBOSE_MOVES=false

# --- M2: DO ingestion. Leave ARENA_DO_URL empty for M1 (isolated) mode. ---
# When set, the arena registers its games with the DO (lobby/TV) and reports
# finished games for archive + rating, and the DO gates spawning (stand-down).
# Use the CANONICAL host: the apex nerfchess.com 301-redirects to www, which
# would break the arena's POSTs — point straight at www.
ARENA_DO_URL=https://www.nerfchess.com
# Shared bearer secret — MUST equal the Worker's ARENA_INGEST_TOKEN secret.
ARENA_INGEST_TOKEN=replace-with-shared-ingest-secret
# How often (ms) to push the live-games registry to the DO.
ARENA_SYNC_MS=4000
