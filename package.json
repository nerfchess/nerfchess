{
  "name": "nerf-chess",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:host": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "server:build": "tsc -p tsconfig.server.json",
    "server:start": "node dist-server/server/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:rules": "npm run server:build && node scripts/test-hexes.cjs",
    "test:nerfs": "npm run server:build && node scripts/test-nerfs.cjs",
    "test:desync": "npm run server:build && node scripts/test-desync.cjs",
    "test:apex": "npm run server:build && node scripts/test-apex.cjs",
    "test:snapshot": "npm run server:build && node scripts/test-snapshot.cjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "next": "16.2.10",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260601.1",
    "@opennextjs/cloudflare": "1.17.1",
    "@types/node": "^22",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5",
    "wrangler": "^4.95.0"
  }
}
