{
  "name": "nerf-chess",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:host": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "server:build": "tsc -p tsconfig.server.json",
    "server:start": "node dist-server/server/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "gen:icons": "npm run server:build && node scripts/gen-card-icons.mjs",
    "gen:house-pfps": "node scripts/gen-house-pfps.mjs",
    "audit:house-bots": "node scripts/gen-house-pfps.mjs --check && npx -y tsx scripts/audit-house-bots.ts",
    "test:san": "npx -y tsx scripts/test-san.ts",
    "test:card-impact": "npx -y tsx scripts/test-card-impact.ts",
    "test:rules": "npm run server:build && node scripts/gen-card-icons.mjs --check && node scripts/test-hexes.cjs && node scripts/check-sig-plugins.cjs",
    "test:nerfs": "npm run server:build && node scripts/test-nerfs.cjs",
    "test:passive-registry": "npx -y tsx scripts/test-passive-registry.ts",
    "test:animations": "npx -y tsx scripts/audit-animations.ts",
    "test:emdash": "npx -y tsx scripts/check-emdash.ts",
    "test:sound": "node scripts/check-sound-coverage.cjs",
    "test:card-registry": "npx -y tsx scripts/gen-card-registry.ts --check",
    "test:draft-fairness": "npx -y tsx scripts/test-draft-fairness.ts",
    "test:draft-sequence": "npx -y tsx scripts/test-draft-sequence.ts",
    "test:draft-timeout": "npx -y tsx scripts/test-draft-timeout.ts",
    "audit:cards": "npx -y tsx scripts/audit-cards.ts",
    "test:buff-purity": "npx -y tsx scripts/test-buff-purity.ts",
    "test:balance-fixes": "npx -y tsx scripts/test-balance-fixes.ts",
    "test:card-audit": "npx -y tsx scripts/audit-cards.ts --check",
    "test:lab": "npx -y tsx scripts/lab-run-all.ts",
    "test:desync": "npm run server:build && node scripts/test-desync.cjs",
    "test:apex": "npm run server:build && node scripts/test-apex.cjs",
    "test:snapshot": "npm run server:build && node scripts/test-snapshot.cjs",
    "test:glicko": "npx -y tsx scripts/test-glicko.ts",
    "test:spectator-sync": "npx -y tsx scripts/test-spectator-sync.ts",
    "test:tv-spectator": "npx -y tsx scripts/test-tv-spectator.ts",
    "test:replay-spectate": "npm run server:build && node scripts/test-replay-spectate.cjs",
    "test:archive-replay": "npx -y tsx scripts/test-archive-replay.ts",
    "validate:tv-snapshots": "npm run server:build && node scripts/validate-tv-snapshots.cjs --selftest",
    "test:e2e": "playwright test",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "next": "16.2.10",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260708.1",
    "@opennextjs/cloudflare": "^1.20.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5",
    "wrangler": "^4.110.0"
  }
}
